{
  "name": "KP Lions",
  "short_name": "KP Lions",
  "description": "Our batch fund \u2014 deposits, support requests, and fund health.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0e5a44",
  "theme_color": "#0e5a44",
  "icons": [
    {
      "src": "./icon-v3-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-v3-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-v3-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./apple-touch-icon-v3.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "id": "/",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "categories": [
    "finance",
    "utilities"
  ],
  "lang": "en",
  "dir": "ltr",
  "prefer_related_applications": false,
  "screenshots": [
    {
      "src": "./screenshot-phone.png",
      "sizes": "412x915",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Fund overview and balance"
    }
  ],
  "shortcuts": [
    {
      "name": "Make a deposit",
      "short_name": "Deposit",
      "description": "Record a contribution to the fund",
      "url": "/?action=deposit",
      "icons": [
        {
          "src": "./icon-v3-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Messages",
      "short_name": "Chat",
      "description": "Open batch messages",
      "url": "/?action=chat",
      "icons": [
        {
          "src": "./icon-v3-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Fund balance",
      "short_name": "Balance",
      "description": "View the current fund balance",
      "url": "/?action=overview",
      "icons": [
        {
          "src": "./icon-v3-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "scope_extensions": [],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "edge_side_panel": {
    "preferred_width": 420
  },
  "handle_links": "preferred"
}